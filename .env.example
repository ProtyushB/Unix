# Backend targets for this build.
#
# These values are baked into the APK at build time by react-native-config and
# are read in src/config/env.ts — they are what decides which environment the
# app talks to. Copy this file to .env for local development (.env is
# gitignored); Jenkins stages a per-environment .env for dev and live builds.
#
# Switching environments locally
# ------------------------------
# .env is gitignored, so it does NOT change when you switch branches — check out
# `dev` and your app keeps talking to whatever .env last pointed at. Keep a copy
# per environment (also gitignored) and swap explicitly:
#
#     cp .env.dev .env      # dev backends
#     cp .env.live .env     # live backends  ⚠️ production data
#     cp .env.main .env     # whatever main is currently pointed at
#
# Rebuild after switching — these are baked in at build time, not read at
# startup. The web preview (`npm run web`) reads the same .env, so it follows.
#
# Local development (defaults below):
#   AUTH_API_URL=http://localhost:8085
#   *_API_URL=http://localhost:8086
#   DMS_API_URL=http://localhost:8087
#
# dev builds:
#   AUTH_API_URL=https://auth.dev.eternitytechnologies.in
#   PERSON/PARLOUR/PHARMACY/RESTAURANT_API_URL=https://modulex.dev.eternitytechnologies.in
#   DMS_API_URL=https://dms.dev.eternitytechnologies.in
#
# live builds:
#   AUTH_API_URL=https://auth.live.eternitytechnologies.in
#   PERSON/PARLOUR/PHARMACY/RESTAURANT_API_URL=https://modulex.live.eternitytechnologies.in
#   DMS_API_URL=https://dms.live.eternitytechnologies.in

AUTH_API_URL=http://localhost:8085
PERSON_API_URL=http://localhost:8086
PARLOUR_API_URL=http://localhost:8086
PHARMACY_API_URL=http://localhost:8086
RESTAURANT_API_URL=http://localhost:8086
DMS_API_URL=http://localhost:8087

# DMS folder ids differ per environment — each DMS instance seeds its own tree.
DMS_APP_ROOT_FOLDER_ID=1
DMS_BUSINESS_APP_ROOT_FOLDER_ID=2

# DMS file id of the global payment QR. 0 renders a "not configured"
# placeholder. Live uses 503; dev needs its own uploaded QR.
PAYMENT_QR_FILE_ID=0
