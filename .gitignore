# Android
.gradle
local.properties
*.iml
*.hprof
.cxx/
# The signing key is the one unrecoverable asset here: this app self-hosts its APK
# updates, so a leaked key cannot be rotated without every installed device having to
# uninstall and reinstall. `*.keystore` alone was too narrow — it does not match
# `unix-release-key.keystore.bak-20260806`, so a routine backup taken next to the
# original sits in `git status` as an ordinary untracked file, one `git add -A` from
# being published. The suffix wildcards close that.
*.keystore
*.keystore.*
*.jks
*.jks.*
!debug.keystore

# Gradle
/android/app/build/
/android/build/

# Bundle artifacts
*.jsbundle

# CocoaPods
/ios/Pods/

# Env
# .env is the active config; .env.dev / .env.live / .env.main are the per-branch
# copies you switch between (see .env.example). All of them hold real backend
# URLs and stay out of git — .env.example is the only tracked one.
.env
.env.*
!.env.example

